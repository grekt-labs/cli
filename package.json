{
  "name": "grekt",
  "version": "0.1.0",
  "description": "CLI for managing AI artifacts (agents, skills, commands)",
  "type": "module",
  "bin": {
    "grekt": "./src/index.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "build:linux": "bun build src/index.ts --compile --outfile dist/grekt-linux-x64",
    "build:mac-arm": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/grekt-macos-arm64",
    "build:mac-intel": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/grekt-macos-x64",
    "build:windows": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/grekt-windows.exe",
    "build:all": "bun run build:linux && bun run build:mac-arm && bun run build:mac-intel && bun run build:windows",
    "deploy": "bun run scripts/deploy.ts",
    "release": "bun run build:all && bun run deploy",
    "publish-artifact": "bun run scripts/publish-artifact.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "@inquirer/prompts": "^7.2.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "chalk": "^5.4.1",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.971.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
